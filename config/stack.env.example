# Development values only. Replace both LiveKit credentials before deployment.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_PUBLIC_URL=wss://rtc.meeting.reisub.xyz
# Discover the public media IP through STUN by default.
# For an explicit public IP, set LIVEKIT_NODE_IP and set discovery to false.
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=true
PORT=8080
CORS_ALLOWED_ORIGINS=https://meeting.reisub.xyz

MANAGER_COOKIE_SECURE=true
MANAGER_BIND_ADDRESS=127.0.0.1
MANAGER_PORT=8090
